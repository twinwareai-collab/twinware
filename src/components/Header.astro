---
import { nav, site } from "../data/site";
---

<header class="masthead">
  <div class="shell bar">
    <nav class="nav nav--left" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={`/${item.href}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="wordmark display" href="/">Twinware</a>

    <div class="nav nav--right">
      <a class="contact" href="/#kontakt">Projekt anfragen</a>
    </div>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobilmenu"
      data-menu-open
    >
      <span class="burger__label">Menü</span>
      <span class="burger__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="overlay" id="mobilmenu" hidden>
  <div class="overlay__top shell">
    <span class="wordmark display">Twinware</span>
    <button class="close" type="button" data-menu-close>Schließen</button>
  </div>
  <nav class="overlay__nav shell" aria-label="Navigation">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={`/${item.href}`} data-menu-close>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/#kontakt" data-menu-close>Kontakt</a>
      </li>
    </ul>
  </nav>
  <div class="overlay__foot shell">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.city}</span>
  </div>
</div>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 3.5rem;
    gap: 1rem;
  }

  .wordmark {
    font-size: 1.4rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-indent: 0.16em;
    justify-self: center;
  }

  .nav ul {
    display: flex;
    gap: 1.75rem;
  }

  .nav a {
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
  }

  .nav a:hover {
    border-bottom-color: var(--color-accent);
  }

  .nav--right {
    justify-self: end;
  }

  .contact {
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .burger {
    display: none;
    justify-self: end;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 0;
    padding: 0.5rem 0;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    color: inherit;
  }

  .burger__bars {
    display: grid;
    gap: 4px;
    width: 20px;
  }

  .burger__bars i {
    height: 1.5px;
    background: currentColor;
  }

  @media (max-width: 59.99rem) {
    .nav {
      display: none;
    }
    .bar {
      grid-template-columns: 1fr auto;
    }
    .wordmark {
      justify-self: start;
    }
    .burger {
      display: flex;
    }
  }

  /* Overlay */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-night);
    color: var(--color-paper);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-block: 1rem 2.5rem;
  }

  .overlay[hidden] {
    display: none;
  }

  .overlay__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
  }

  .overlay__top .wordmark {
    justify-self: start;
  }

  .close {
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .overlay__nav {
    display: flex;
    align-items: center;
  }

  .overlay__nav ul {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }

  .overlay__nav a {
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    line-height: 1.15;
    text-decoration: none;
    display: block;
    border-bottom: 1px solid var(--color-rule-dark);
    padding-block: 0.4rem;
  }

  .overlay__foot {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: #a8a29b;
  }

  .overlay__foot a {
    text-decoration: none;
  }
</style>

<script>
  const setup = () => {
    const overlay = document.getElementById("mobilmenu");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    if (!overlay || !openBtn) return;

    const setOpen = (open: boolean) => {
      overlay.hidden = !open;
      openBtn.setAttribute("aria-expanded", String(open));
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    openBtn.addEventListener("click", () => setOpen(true));
    overlay
      .querySelectorAll("[data-menu-close]")
      .forEach((el) => el.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) setOpen(false);
    });
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
