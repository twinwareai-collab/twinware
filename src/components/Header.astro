---
import { nav, site } from "../data/site";
---

<div class="scrollbar" aria-hidden="true"><span data-scrollbar></span></div>

<header class="masthead">
  <div class="shell bar">
    <a class="brand" href="/" aria-label={`${site.name} – Start`} data-brand>
      <canvas class="brand__mark" data-brand-mark aria-hidden="true"></canvas>
      <span class="brand__word display" aria-hidden="true">
        {
          [...site.name.toUpperCase()].map((c, i, arr) => (
            <span
              class="brand__ch"
              data-final={c}
              style={`--depth: ${(Math.sin((i / (arr.length - 1)) * Math.PI) * 4).toFixed(2)}`}
            >
              {c}
            </span>
          ))
        }
      </span>
    </a>

    <div class="nav-group">
      <nav class="nav" aria-label="Hauptnavigation">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={`/${item.href}`}>
                  <span class="nav__swap">
                    <span class="nav__label">{item.label}</span>
                    <span class="nav__label nav__label--ghost" aria-hidden="true">
                      {item.label}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="contact" href="/#kontakt">
        <span class="contact__label">Projekt anfragen</span>
        <span class="contact__shine" aria-hidden="true"></span>
        <span class="contact__corner contact__corner--tl" aria-hidden="true"></span>
        <span class="contact__corner contact__corner--tr" aria-hidden="true"></span>
        <span class="contact__corner contact__corner--bl" aria-hidden="true"></span>
        <span class="contact__corner contact__corner--br" aria-hidden="true"></span>
      </a>
    </div>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobilmenu"
      data-menu-open
    >
      <span class="burger__label">Menü</span>
      <span class="burger__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="overlay" id="mobilmenu" hidden>
  <div class="overlay__top shell">
    <span class="wordmark display">{site.name}</span>
    <button class="close" type="button" data-menu-close>Schließen</button>
  </div>
  <nav class="overlay__nav shell" aria-label="Navigation">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={`/${item.href}`} data-menu-close>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/#kontakt" data-menu-close>Kontakt</a>
      </li>
    </ul>
  </nav>
  <div class="overlay__foot shell">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.city}</span>
  </div>
</div>

<style>
  /* Kein backdrop-filter: der Header liegt ueber der animierten Hero-Canvas,
     jedes Canvas-Frame wuerde sonst einen neuen Blur-Pass ausloesen. */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    transition:
      background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .masthead--overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: transparent;
    border-bottom-color: transparent;
    color: var(--color-paper);
  }

  .masthead--overlay.masthead--solid {
    background: var(--color-paper);
    border-bottom-color: var(--color-rule);
    color: inherit;
  }

  /* Beim Runterscrollen aus dem Weg, beim Hochscrollen sofort wieder da. */
  .masthead {
    transform: translateY(0);
    will-change: transform;
  }

  .masthead--hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead--hidden {
      transform: none;
    }
  }

  .scrollbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 70;
    background: transparent;
    pointer-events: none;
  }

  .scrollbar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    gap: 1.5rem;
  }

  .brand {
    --rx: 0deg;
    --ry: 0deg;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand.is-tracking {
    transition: none;
  }

  .brand__mark {
    width: 3.5rem;
    height: 3.5rem;
    display: block;
    margin: -0.75rem -0.25rem;
    /* Eigene Compositing-Ebene: die Repaints der Canvas sollen nicht
       den gesamten Header-Layer neu zeichnen lassen. */
    transform: translateZ(0);
    contain: paint;
  }

  .brand__word {
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    display: flex;
    transform-style: preserve-3d;
  }

  /* Buchstaben stehen gestaffelt im Raum: beim Kippen entsteht echte Parallaxe. */
  .brand__ch {
    display: inline-block;
    min-width: 0.62em;
    text-align: center;
    transform: translateZ(calc(var(--depth, 0) * 3px));
  }

  .brand__ch.is-locking {
    color: var(--color-accent);
  }


  .nav-group {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    position: relative;
    display: block;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-block: 0.4rem;
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: var(--color-accent);
    transition: right 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav a:hover::after {
    right: 0;
  }

  /* Label faehrt nach oben raus, die Kopie kommt von unten nach. */
  .nav__swap {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .nav__label {
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__label--ghost {
    position: absolute;
    inset: 0;
    color: var(--color-accent);
    transform: translateY(100%);
  }

  .nav a:hover .nav__label {
    transform: translateY(-100%);
  }

  .nav a:hover .nav__label--ghost {
    transform: translateY(0);
  }

  /* Eckklammern statt durchgehendem Rahmen, dazu ein Lichtstreifen beim Hover. */
  .contact {
    position: relative;
    display: inline-flex;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.7rem 1.25rem;
    border-radius: 0.375rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact.is-pulled {
    transition: none;
  }

  .contact__label {
    position: relative;
    z-index: 2;
  }

  .contact__shine {
    position: absolute;
    top: 0;
    left: -75%;
    z-index: 1;
    width: 50%;
    height: 100%;
    background: color-mix(in srgb, var(--color-accent) 45%, transparent);
    filter: blur(12px);
    transform: rotate(12deg);
    transition: left 1s ease-in-out;
  }

  .contact:hover .contact__shine {
    left: 125%;
  }

  .contact__corner {
    position: absolute;
    display: block;
    width: 50%;
    border-color: var(--color-accent);
    border-style: solid;
    border-width: 0;
    transition: height 0.3s ease;
  }

  .contact__corner--tl {
    top: 0;
    left: 0;
    height: 20%;
    border-left-width: 2px;
    border-top-width: 2px;
    border-top-left-radius: 0.375rem;
  }

  .contact__corner--tr {
    top: 0;
    right: 0;
    height: 60%;
    border-right-width: 2px;
    border-top-width: 2px;
    border-top-right-radius: 0.375rem;
  }

  .contact__corner--bl {
    bottom: 0;
    left: 0;
    height: 60%;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-bottom-left-radius: 0.375rem;
  }

  .contact__corner--br {
    bottom: 0;
    right: 0;
    height: 20%;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-right-radius: 0.375rem;
  }

  .contact:hover .contact__corner--tr,
  .contact:hover .contact__corner--bl {
    height: 90%;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__shine {
      display: none;
    }
  }

  .burger {
    display: none;
    justify-self: end;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 0;
    padding: 0.5rem 0;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    color: inherit;
  }

  .burger__bars {
    display: grid;
    gap: 4px;
    width: 20px;
  }

  .burger__bars i {
    height: 1.5px;
    background: currentColor;
  }

  @media (max-width: 59.99rem) {
    .nav-group {
      display: none;
    }
    .burger {
      display: flex;
      margin-left: auto;
    }
  }

  /* Overlay */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-night);
    color: var(--color-paper);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-block: 1rem 2.5rem;
  }

  .overlay[hidden] {
    display: none;
  }

  .overlay__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
  }

  .wordmark {
    font-size: 1.4rem;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
  }

  .close {
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .overlay__nav {
    display: flex;
    align-items: center;
  }

  .overlay__nav ul {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }

  .overlay__nav a {
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    line-height: 1.15;
    text-decoration: none;
    display: block;
    border-bottom: 1px solid var(--color-rule-dark);
    padding-block: 0.4rem;
  }

  .overlay__foot {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: #a8a29b;
  }

  .overlay__foot a {
    text-decoration: none;
  }
</style>

<script>
  import * as THREE from "three";

  // Bei jeder Soft-Navigation laufen die Setups erneut. Ohne Abmelden
  // wuerden sich die globalen Listener bei jedem Seitenwechsel stapeln.
  type Teardown = () => void;
  const teardowns: Teardown[] = [];

  const on = (
    target: Window | Document | HTMLElement,
    type: string,
    handler: EventListenerOrEventListenerObject,
    options?: AddEventListenerOptions,
  ) => {
    target.addEventListener(type, handler, options);
    teardowns.push(() => target.removeEventListener(type, handler, options));
  };

  const runTeardowns = () => {
    while (teardowns.length) teardowns.pop()?.();
  };

  const setupScrollbar = () => {
    const bar = document.querySelector<HTMLElement>("[data-scrollbar]");
    if (!bar) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    on(window, "scroll", onScroll, { passive: true });
    on(window, "resize", onScroll);
  };


  let activeBrandMark: { cleanup: () => void } | null = null;

  const setupBrandMark = () => {
    activeBrandMark?.cleanup();
    activeBrandMark = null;

    const canvas = document.querySelector<HTMLCanvasElement>("[data-brand-mark]");
    if (!canvas) return;

    // Diagnose: ?fx=none oder ?fx=hero laesst die Marke weg.
    const fx = new URLSearchParams(location.search).get("fx");
    if (fx === "none" || fx === "hero") return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      return;
    }

    const size = canvas.clientWidth || 30;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(size, size, false);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.z = 5;

    const group = new THREE.Group();
    const accent = 0xff4b2e;

    // Aeussere Huelle, kaum sichtbar, gibt dem System Tiefe.
    const shellGeo = new THREE.IcosahedronGeometry(1.28, 1);
    const shell = new THREE.Mesh(
      shellGeo,
      new THREE.MeshBasicMaterial({
        color: accent,
        wireframe: true,
        transparent: true,
        opacity: 0.22,
      }),
    );

    const coreGeo = new THREE.IcosahedronGeometry(0.42, 1);
    const core = new THREE.Mesh(
      coreGeo,
      new THREE.MeshBasicMaterial({ color: accent, wireframe: true }),
    );

    const ringGeo = new THREE.TorusGeometry(0.8, 0.04, 8, 56);
    const ringA = new THREE.Mesh(
      ringGeo,
      new THREE.MeshBasicMaterial({ color: accent }),
    );
    ringA.rotation.x = 1.15;

    const ringB = new THREE.Mesh(
      ringGeo,
      new THREE.MeshBasicMaterial({ color: accent, transparent: true, opacity: 0.5 }),
    );
    ringB.rotation.set(1.15, 0, Math.PI / 2.4);
    ringB.scale.setScalar(1.22);

    // Zwei Trabanten auf gekippten Bahnen.
    const moonGeo = new THREE.IcosahedronGeometry(0.11, 0);
    const moonMat = new THREE.MeshBasicMaterial({ color: accent });

    const moonA = new THREE.Mesh(moonGeo, moonMat);
    moonA.position.x = 1.02;
    const orbitA = new THREE.Group();
    orbitA.add(moonA);
    orbitA.rotation.z = 0.5;

    const moonB = new THREE.Mesh(moonGeo, moonMat);
    moonB.position.x = 1.3;
    moonB.scale.setScalar(0.72);
    const orbitB = new THREE.Group();
    orbitB.add(moonB);
    orbitB.rotation.set(0.9, 0, -0.7);

    group.add(shell, core, ringA, ringB, orbitA, orbitB);
    group.rotation.set(0.3, 0.4, 0);
    scene.add(group);

    renderer.render(scene, camera);

    let raf = 0;
    let last = performance.now();

    // Scrollen treibt das System an, danach laeuft es wieder aus.
    let spin = 0;
    let lastScroll = window.scrollY;
    const onScrollSpin = () => {
      const delta = window.scrollY - lastScroll;
      lastScroll = window.scrollY;
      spin = Math.max(-9, Math.min(9, spin + delta * 0.02));
    };
    window.addEventListener("scroll", onScrollSpin, { passive: true });

    // Der Planet kippt zum Zeiger.
    let tiltX = 0;
    let tiltY = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let onPointer: ((event: PointerEvent) => void) | null = null;

    if (window.matchMedia("(hover: hover)").matches) {
      onPointer = (event: PointerEvent) => {
        targetTiltY = (event.clientX / window.innerWidth - 0.5) * 1.1;
        targetTiltX = (event.clientY / window.innerHeight - 0.5) * 0.7;
      };
      window.addEventListener("pointermove", onPointer, { passive: true });
    }

    // Hover ueber der Marke oeffnet das System.
    const brand = document.querySelector<HTMLElement>("[data-brand]");
    let open = 0;
    let targetOpen = 0;
    const onEnter = () => (targetOpen = 1);
    const onLeave = () => (targetOpen = 0);
    brand?.addEventListener("pointerenter", onEnter);
    brand?.addEventListener("pointerleave", onLeave);

    // 30 fps: die zweite WebGL-Ebene muss nicht mit voller Rate compositen,
    // die Rotation ist langsam genug, dass man es nicht sieht.
    const FRAME_MS = 1000 / 30;

    function loop(now: number) {
      raf = requestAnimationFrame(loop);

      const since = now - last;
      if (since < FRAME_MS) return;

      const dt = Math.min(since / 1000, 0.08);
      last = now;

      spin *= Math.exp(-dt * 2.4);
      open += (targetOpen - open) * Math.min(1, dt * 6);
      tiltX += (targetTiltX - tiltX) * Math.min(1, dt * 3);
      tiltY += (targetTiltY - tiltY) * Math.min(1, dt * 3);

      const boost = 1 + Math.abs(spin) * 0.5 + open * 1.2;

      group.rotation.y += dt * (0.85 + spin) * (1 + open * 0.8);
      group.rotation.x = 0.3 + spin * 0.05 + tiltX;
      group.rotation.z = tiltY * 0.35;

      core.rotation.y -= dt * 1.1 * boost;
      core.rotation.x += dt * 0.45;

      shell.rotation.y -= dt * 0.25;
      shell.rotation.x += dt * 0.1;
      shell.scale.setScalar(1 + open * 0.12);

      ringA.rotation.z += dt * 0.2 * boost;
      ringB.rotation.z += dt * (0.55 + spin * 0.35);
      ringB.scale.setScalar(1.22 + open * 0.18);

      orbitA.rotation.y += dt * (1.6 + spin * 1.2) * (1 + open);
      orbitB.rotation.y -= dt * (1.1 + spin * 0.8) * (1 + open);
      orbitB.rotation.x += dt * 0.3;

      renderer.render(scene, camera);
    }

    const startLoop = () => {
      if (raf || reduceMotion) return;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stopLoop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };
    const onVisibility = () => (document.hidden ? stopLoop() : startLoop());

    document.addEventListener("visibilitychange", onVisibility);
    startLoop();

    activeBrandMark = {
      cleanup() {
        stopLoop();
        document.removeEventListener("visibilitychange", onVisibility);
        window.removeEventListener("scroll", onScrollSpin);
        if (onPointer) window.removeEventListener("pointermove", onPointer);
        brand?.removeEventListener("pointerenter", onEnter);
        brand?.removeEventListener("pointerleave", onLeave);
        shellGeo.dispose();
        coreGeo.dispose();
        ringGeo.dispose();
        moonGeo.dispose();
        moonMat.dispose();
        (shell.material as THREE.Material).dispose();
        (core.material as THREE.Material).dispose();
        (ringA.material as THREE.Material).dispose();
        (ringB.material as THREE.Material).dispose();
        renderer.forceContextLoss();
        renderer.dispose();
      },
    };
  };


  // Wortmarke wie im Hero: kurz durchwuerfeln, dann einrasten.
  const CHARSET = "01#%&+=/<>{}[]$*ABCDEFGHIJKLMNOPQRSTUVWXYZ";

  const scrambleWord = (root: HTMLElement) => {
    const chars = root.querySelectorAll<HTMLElement>(".brand__ch");
    if (!chars.length) return;

    chars.forEach((ch, i) => {
      const final = ch.dataset.final ?? ch.textContent ?? "";
      const delay = i * 55;
      const duration = 260;
      let elapsed = 0;

      const timer = window.setInterval(() => {
        elapsed += 40;
        if (elapsed < delay) return;
        if (elapsed >= delay + duration) {
          ch.textContent = final;
          ch.classList.add("is-locking");
          window.setTimeout(() => ch.classList.remove("is-locking"), 220);
          window.clearInterval(timer);
          return;
        }
        ch.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
      }, 40);
    });
  };

  const setupBrandWord = () => {
    const brand = document.querySelector<HTMLElement>("[data-brand]");
    if (!brand) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    scrambleWord(brand);

    let busy = false;
    brand.addEventListener("pointerenter", () => {
      if (busy) return;
      busy = true;
      scrambleWord(brand);
      window.setTimeout(() => (busy = false), 700);
    });
  };


  // Der CTA zieht leicht zum Zeiger und federt zurueck.
  const setupMagneticCta = () => {
    const cta = document.querySelector<HTMLElement>(".contact");
    if (!cta) return;
    if (!window.matchMedia("(hover: hover)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const RANGE = 90;
    const PULL = 0.28;

    const onMove = (event: PointerEvent) => {
      const rect = cta.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = event.clientX - cx;
      const dy = event.clientY - cy;

      if (Math.abs(dx) > RANGE || Math.abs(dy) > RANGE) {
        cta.classList.remove("is-pulled");
        cta.style.transform = "";
        return;
      }

      cta.classList.add("is-pulled");
      cta.style.transform = `translate(${(dx * PULL).toFixed(1)}px, ${(dy * PULL).toFixed(1)}px)`;
    };

    const onLeave = () => {
      cta.classList.remove("is-pulled");
      cta.style.transform = "";
    };

    on(window, "pointermove", onMove, { passive: true });
    on(cta, "pointerleave", onLeave);
  };


  // Das ganze Lockup kippt im Raum mit, die Buchstaben laufen dabei
  // wegen ihrer gestaffelten Tiefe unterschiedlich schnell.
  const setupBrandTilt = () => {
    const brand = document.querySelector<HTMLElement>("[data-brand]");
    if (!brand) return;
    if (!window.matchMedia("(hover: hover)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let raf = 0;
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;

    const onMove = (event: PointerEvent) => {
      const rect = brand.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      targetY = Math.max(-18, Math.min(18, (event.clientX - cx) / 26));
      targetX = Math.max(-14, Math.min(14, -(event.clientY - cy) / 8));

      brand.classList.add("is-tracking");
      if (!raf) raf = requestAnimationFrame(step);
    };

    const step = () => {
      curX += (targetX - curX) * 0.12;
      curY += (targetY - curY) * 0.12;
      brand.style.setProperty("--rx", `${curX.toFixed(2)}deg`);
      brand.style.setProperty("--ry", `${curY.toFixed(2)}deg`);

      if (Math.abs(targetX - curX) > 0.05 || Math.abs(targetY - curY) > 0.05) {
        raf = requestAnimationFrame(step);
      } else {
        raf = 0;
      }
    };

    const reset = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      curX = 0;
      curY = 0;
      targetX = 0;
      targetY = 0;
      brand.classList.remove("is-tracking");
      brand.style.setProperty("--rx", "0deg");
      brand.style.setProperty("--ry", "0deg");
    };

    on(window, "pointermove", onMove, { passive: true });
    on(document, "pointerleave", reset);
  };


  // Header weicht beim Runterscrollen, kommt beim Hochscrollen zurueck.
  const setupAutoHide = () => {
    const header = document.querySelector<HTMLElement>(".masthead");
    if (!header) return;

    const THRESHOLD = 120;
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const delta = y - lastY;

      if (Math.abs(delta) < 6) return;

      const menuOpen = document
        .getElementById("mobilmenu")
        ?.hasAttribute("hidden") === false;

      if (!menuOpen && delta > 0 && y > THRESHOLD) {
        header.classList.add("masthead--hidden");
      } else if (delta < 0) {
        header.classList.remove("masthead--hidden");
      }

      lastY = y;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    on(window, "scroll", onScroll, { passive: true });
  };


  const setup = () => {
    const overlay = document.getElementById("mobilmenu");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    if (!overlay || !openBtn) return;

    const setOpen = (open: boolean) => {
      overlay.hidden = !open;
      openBtn.setAttribute("aria-expanded", String(open));
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    openBtn.addEventListener("click", () => setOpen(true));
    overlay
      .querySelectorAll("[data-menu-close]")
      .forEach((el) => el.addEventListener("click", () => setOpen(false)));
    on(document, "keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape" && !overlay.hidden) setOpen(false);
    });
  };


  const setupOverlayHeader = () => {
    const header = document.querySelector<HTMLElement>(".masthead");
    const hero = document.querySelector(".hero");
    if (!header || !hero) return;

    header.classList.add("masthead--overlay");
    const onScroll = () => {
      header.classList.toggle("masthead--solid", window.scrollY > 48);
    };
    onScroll();
    on(window, "scroll", onScroll, { passive: true });
  };

  const initHeader = () => {
    runTeardowns();
    setupScrollbar();
    setupBrandMark();
    setupBrandWord();
    setupMagneticCta();
    setupBrandTilt();
    setupAutoHide();
    setup();
    setupOverlayHeader();
  };

  // astro:page-load feuert auch beim ERSTEN Laden.
  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:before-swap", () => {
    runTeardowns();
    activeBrandMark?.cleanup();
    activeBrandMark = null;
  });
</script>
