---
import { site } from "../data/site";
---

<section class="hero">
  <canvas class="hero__stars" aria-hidden="true"></canvas>

  <div class="hero__inner shell">
    <p class="hero__kicker">Softwarefirma mit Konzern-Erfahrung im Rücken</p>

    <h1 class="hero__title display" aria-label={site.name}>
      <span class="hero__scramble" aria-hidden="true">
        {
          [..."TWINWARE"].map((c, i, arr) => (
            <span class="ch" style={`--i:${i}`}>
              <span class="ch-spacer">{c}</span>
              <span class="ch-glyph" data-final={c}>{c}</span>
              {i === arr.length - 1 && <span class="hero__cursor" />}
            </span>
          ))
        }
      </span>
    </h1>

    <div class="hero__foot">
      <p class="hero__sub">
        Websites und Webapps aus {site.city}. Wir bauen die Dinge,
        die Ihr Betrieb jeden Tag benutzt – und danach lassen wir Sie damit nicht
        allein.
      </p>
      <a class="textlink hero__link" href="#leistungen">Was wir machen</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 85% at 88% 115%, rgba(255, 75, 46, 0.38), transparent 60%),
      radial-gradient(70% 55% at 8% -15%, rgba(255, 75, 46, 0.16), transparent 60%),
      var(--color-night);
    color: var(--color-paper);
    padding-top: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 1cm);
    min-height: calc(100svh - 1cm);
  }

  .hero__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    transition: opacity 1.6s ease;
    pointer-events: none;
  }

  .hero__stars.is-active {
    opacity: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .hero__kicker {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-size: clamp(3.5rem, 15.2vw, 15rem);
    margin: 0;
  }

  .hero__scramble {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-variant-ligatures: none;
  }

  .ch {
    position: relative;
    display: inline-block;
  }

  .ch-spacer {
    visibility: hidden;
  }

  .ch-glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    text-shadow: none;
    transition:
      color 0.15s ease,
      text-shadow 0.15s ease;
  }

  .ch-glyph.is-locking {
    color: var(--color-accent);
    text-shadow: 0 0 0.5em rgba(255, 75, 46, 0.85);
  }

  .ch:nth-child(5) .ch-glyph {
    color: var(--color-accent);
  }

  .hero__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 0.09em;
    margin-left: 0.06em;
    background: var(--color-accent);
    opacity: 0;
  }

  .hero__cursor.is-blinking {
    animation: cursor-blink 0.85s step-end 5;
  }

  @keyframes cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-glyph {
      transition: none;
    }
    .hero__cursor {
      display: none;
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__sub {
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: #cfc9c2;
  }

  @media (min-width: 60rem) {
    .hero__foot {
      grid-template-columns: minmax(0, 38rem) auto;
      align-items: end;
      justify-content: space-between;
      gap: 3rem;
    }
    .hero__link {
      margin-bottom: 0.35rem;
    }
  }

</style>

<script>
  function initHeroFx() {
    const hero = document.querySelector<HTMLElement>(".hero");
    const canvas = hero?.querySelector<HTMLCanvasElement>(".hero__stars");
    const glyphs = hero?.querySelectorAll<HTMLElement>(".hero__title .ch-glyph");
    const cursor = hero?.querySelector<HTMLElement>(".hero__cursor");
    if (!hero || !canvas || !glyphs || !glyphs.length) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let width = 0;
    let height = 0;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      width = hero!.clientWidth;
      height = hero!.clientHeight;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener("resize", resize);

    type Star = { x: number; y: number; z: number };
    const STAR_COUNT = 90;
    const stars: Star[] = [];

    function resetStar(s: Star) {
      s.x = (Math.random() - 0.5) * width;
      s.y = (Math.random() - 0.5) * height;
      s.z = width;
    }

    for (let i = 0; i < STAR_COUNT; i++) {
      const s: Star = { x: 0, y: 0, z: 0 };
      resetStar(s);
      s.z = Math.random() * width;
      stars.push(s);
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);
      const cx = width / 2;
      const cy = height / 2;
      for (const s of stars) {
        const prevK = 128 / (s.z + 8);
        s.z -= 3;
        if (s.z <= 0) resetStar(s);

        const k = 128 / (s.z + 8);
        const x = s.x * k + cx;
        const y = s.y * k + cy;

        if (x < -50 || x > width + 50 || y < -50 || y > height + 50) {
          resetStar(s);
          continue;
        }

        const px = s.x * prevK + cx;
        const py = s.y * prevK + cy;
        const fade = Math.min(1, (1 - s.z / width) * 1.6);

        ctx!.globalAlpha = fade;
        ctx!.strokeStyle = "#fff2e8";
        ctx!.lineWidth = fade * 1.6;
        ctx!.beginPath();
        ctx!.moveTo(px, py);
        ctx!.lineTo(x, y);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
      requestAnimationFrame(draw);
    }

    function drawStatic() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = "#fff2e8";
      for (const s of stars) {
        ctx!.globalAlpha = 0.55;
        ctx!.beginPath();
        ctx!.arc(Math.random() * width, Math.random() * height, 1.1, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    function start() {
      canvas!.classList.add("is-active");
      if (reduceMotion) {
        drawStatic();
      } else {
        draw();
      }
    }

    if (reduceMotion) {
      start();
      return;
    }

    const CHARSET = "01#%&+=/<>{}[]$*ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const TICK_MS = 45;
    const SCRAMBLE_MS = 480;
    const STAGGER_MS = 150;
    const START_DELAY_MS = 150;

    let maxFinish = 0;

    glyphs.forEach((glyph, i) => {
      const final = glyph.dataset.final ?? glyph.textContent ?? "";
      const delay = START_DELAY_MS + i * STAGGER_MS;
      const finish = delay + SCRAMBLE_MS;
      maxFinish = Math.max(maxFinish, finish);

      let elapsed = 0;
      const timer = window.setInterval(() => {
        elapsed += TICK_MS;
        if (elapsed < delay) return;
        if (elapsed >= finish) {
          glyph.textContent = final;
          glyph.classList.add("is-locking");
          window.setTimeout(() => glyph.classList.remove("is-locking"), 260);
          window.clearInterval(timer);
          return;
        }
        glyph.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
      }, TICK_MS);
    });

    window.setTimeout(() => {
      cursor?.classList.add("is-blinking");
      start();
    }, maxFinish + 250);
  }

  initHeroFx();
</script>
