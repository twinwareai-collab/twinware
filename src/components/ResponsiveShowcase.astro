---
import MiniLayout from "./MiniLayout.astro";

const punkte = [
  {
    title: "Zuerst das Telefon",
    text: "Zwei von drei Besuchern kommen mobil. Wir bauen die kleine Ansicht zuerst und dehnen sie nach oben, nicht umgekehrt.",
  },
  {
    title: "Unter einer Sekunde",
    text: "Keine Seite, die erst nachlädt, springt und dann Ihren Besucher verliert. Bilder und Schriften kommen mit.",
  },
  {
    title: "Für alle bedienbar",
    text: "Tastatur, Screenreader, Kontrast. Nicht nur, weil es ab 2025 für viele Betriebe Pflicht ist.",
  },
];
---

<section class="section section--night showcase" id="responsive">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">Ein Entwurf, drei Größen</p>
      <div>
        <h2 class="headline">Dieselbe Seite auf jedem Gerät.</h2>
        <p class="lede showcase__lede">
          Nicht dreimal gebaut, sondern einmal richtig. Das Telefon in der Mitte
          scrollt von allein – halten Sie den Zeiger darauf, um anzuhalten.
        </p>
      </div>
    </div>
  </div>

  <div class="stage">
    <div class="devices">
      <figure class="frame frame--desktop">
        <figcaption class="frame__cap">Desktop · 1440px</figcaption>
        <div class="browser">
          <div class="browser__bar">
            <span class="browser__dots"><i></i><i></i><i></i></span>
            <span class="browser__url">twinware.de</span>
          </div>
          <div class="browser__view">
            <MiniLayout cols={3} unit="13px" />
          </div>
        </div>
      </figure>

      <figure class="frame frame--phone">
        <figcaption class="frame__cap">Telefon · 390px</figcaption>
        <div class="phone" data-phone>
          <div class="phone__screen">
            <div class="phone__status">
              <span>9:41</span>
              <span class="phone__icons">
                <i class="sig"></i>
                <i class="wifi"></i>
                <i class="bat"></i>
              </span>
            </div>
            <div class="phone__scroll" data-scroll>
              <MiniLayout cols={1} unit="15px" long />
            </div>
            <span class="phone__bar"></span>
          </div>
          <span class="phone__island"></span>
        </div>
      </figure>

      <figure class="frame frame--tablet">
        <figcaption class="frame__cap">Tablet · 834px</figcaption>
        <div class="browser">
          <div class="browser__bar">
            <span class="browser__dots"><i></i><i></i><i></i></span>
            <span class="browser__url">twinware.de</span>
          </div>
          <div class="browser__view">
            <MiniLayout cols={2} unit="12px" />
          </div>
        </div>
      </figure>
    </div>
  </div>

  <div class="shell">
    <ul class="punkte">
      {
        punkte.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .showcase__lede {
    margin-top: 1rem;
    color: #b8b2ab;
  }

  .stage {
    overflow: hidden;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
  }

  .devices {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .frame {
    margin: 0;
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .frame__cap {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a847d;
    order: 2;
  }

  .frame--desktop,
  .frame--tablet {
    display: none;
  }

  @media (min-width: 64rem) {
    .frame--desktop,
    .frame--tablet {
      display: grid;
    }
    .frame--phone {
      margin-bottom: 3.5rem;
      justify-items: center;
    }
  }

  /* Browserrahmen */
  .browser {
    width: 34rem;
    background: #1a1a1a;
    border: 1px solid #3a3a3a;
    order: 1;
  }

  .frame--tablet .browser {
    width: 21rem;
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid #3a3a3a;
  }

  .browser__dots {
    display: flex;
    gap: 0.25rem;
  }

  .browser__dots i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #4a4a4a;
  }

  .browser__url {
    font-size: 0.5625rem;
    color: #8a847d;
    letter-spacing: 0.04em;
    background: #262626;
    padding: 0.15rem 0.6rem;
    flex: 1;
  }

  .browser__view {
    height: 22rem;
    overflow: hidden;
  }

  .frame--tablet .browser__view {
    height: 19rem;
  }

  /* Telefon */
  .phone {
    --screen-h: 30rem;
    position: relative;
    width: 15.5rem;
    padding: 0.5rem;
    background: #050505;
    border: 1px solid #3a3a3a;
    border-radius: 2.2rem;
    box-shadow: inset 0 0 0 2px #1e1e1e;
    order: 1;
  }

  @media (max-width: 30rem) {
    .phone {
      --screen-h: 26rem;
      width: 14rem;
    }
  }

  .phone__screen {
    position: relative;
    height: var(--screen-h);
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--color-paper);
  }

  .phone__island {
    position: absolute;
    top: 0.95rem;
    left: 50%;
    transform: translateX(-50%);
    width: 4.2rem;
    height: 1.05rem;
    background: #050505;
    border-radius: 999px;
    z-index: 3;
  }

  .phone__status {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.1rem 0;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-ink);
    background: linear-gradient(
      to bottom,
      var(--color-paper) 62%,
      transparent
    );
    height: 1.9rem;
  }

  .phone__icons {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .phone__icons i {
    display: block;
    background: var(--color-ink);
  }

  .phone__icons .sig {
    width: 0.85rem;
    height: 0.5rem;
    clip-path: polygon(0 70%, 22% 70%, 22% 100%, 0 100%, 0 70%, 33% 45%, 55% 45%, 55% 100%, 33% 100%, 33% 45%, 66% 20%, 88% 20%, 88% 100%, 66% 100%);
  }

  .phone__icons .wifi {
    width: 0.6rem;
    height: 0.45rem;
    clip-path: polygon(50% 100%, 0 35%, 15% 20%, 50% 55%, 85% 20%, 100% 35%);
  }

  .phone__icons .bat {
    width: 1.1rem;
    height: 0.5rem;
    border-radius: 2px;
    background: none;
    border: 1px solid var(--color-ink);
    position: relative;
  }

  .phone__icons .bat::after {
    content: "";
    position: absolute;
    inset: 1.5px;
    right: 40%;
    background: var(--color-ink);
  }

  .phone__bar {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 3px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.35);
    z-index: 2;
  }

  .phone__scroll {
    padding-top: 1.9rem;
    transform: translateY(0);
  }

  .phone.is-running .phone__scroll {
    animation: drift 26s ease-in-out infinite alternate;
  }

  .phone:hover .phone__scroll,
  .phone:focus-within .phone__scroll {
    animation-play-state: paused;
  }

  @keyframes drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-100% + var(--screen-h) - 1rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone.is-running .phone__scroll {
      animation: none;
    }
  }

  /* Punkte darunter */
  .punkte {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-rule-dark);
  }

  .punkte li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-rule-dark);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  @media (min-width: 56rem) {
    .punkte {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .punkte li {
      border-bottom: 0;
      padding-right: clamp(1rem, 3vw, 2.5rem);
      border-right: 1px solid var(--color-rule-dark);
    }
    .punkte li + li {
      padding-left: clamp(1rem, 3vw, 2.5rem);
    }
    .punkte li:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }

  .punkte h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .punkte p {
    color: #a8a29b;
    font-size: 0.9375rem;
    max-width: 24rem;
  }
</style>

<script>
  const setup = () => {
    const phones = document.querySelectorAll<HTMLElement>("[data-phone]");
    if (!phones.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle("is-running", entry.isIntersecting);
        });
      },
      { threshold: 0.25 },
    );
    phones.forEach((p) => io.observe(p));
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
