---
import { gruender, site } from "../data/site";
---

<section class="section section--night" id="ueber-uns">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div>
        <h2 class="headline">Zwei Entwickler, ein Büro in {site.city}.</h2>
        <p class="lede about__lede">
          Keine Agentur mit Projektleitung, Account-Betreuung und drei
          Zwischenschichten. Sie sprechen mit den Leuten, die auch bauen.
        </p>
      </div>
    </div>

    <ul class="people">
      {
        gruender.map((g, i) => (
          <li class="person" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <div class="person__portrait">
              {/* TODO: Portraitfoto einsetzen */}
              <span class="display">{g.name.slice(0, 1)}</span>
            </div>
            <div>
              <h3 class="headline headline--sm">{g.name}</h3>
              <p class="person__role">{g.role}</p>
              <p class="person__text">{g.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__lede {
    margin-top: 1rem;
    color: #b8b2ab;
  }

  .people {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .person {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: rgba(255, 255, 255, 0.045);
    align-content: start;
  }

  .person__portrait {
    aspect-ratio: 4 / 5;
    background: #1c1c1c;
    display: grid;
    place-items: center;
    color: #4a4a4a;
    font-size: 2rem;
  }

  .person__role {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8a29b;
    margin-top: 0.5rem;
  }

  .person__text {
    margin-top: 0.9rem;
    color: #a8a29b;
    font-size: 0.9375rem;
  }
</style>
