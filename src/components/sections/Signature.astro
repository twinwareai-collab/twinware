---
/**
 * Marken-Moment kurz vor dem Kontakt: der Satz kreist, der Zeiger druckt ihn
 * auseinander. Der Text steht zusaetzlich als echtes Markup im Dokument,
 * damit er auch ohne Canvas gelesen und vorgelesen werden kann.
 */
---
<section class="signature" aria-labelledby="signature-title" data-vortex>
  <div class="signature-stage" data-vortex-host>
    <canvas data-vortex-canvas aria-hidden="true"></canvas>
    <div class="signature-core">
      <p class="eyebrow"><span>Twinware</span></p>
      <h2 id="signature-title">Ihr Partner für digitale Produkte.</h2>
      <a class="ln" href="#kontakt">Erstgespräch vereinbaren <b class="arrow arrow--sm" aria-hidden="true"></b></a>
    </div>
  </div>
</section>
