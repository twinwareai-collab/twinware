---
import { siteConfig } from '@/config/site';
---
<header class="site-header" data-header>
  <div class="header-shell">
    <a class="brand" href="#top" aria-label="TWINWARE Startseite">
      <span class="brand-symbol" aria-hidden="true"><i></i><i></i></span>
      <span>{siteConfig.brand}</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      {siteConfig.nav.map((item) => <a class="ln" href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-cta" href="#kontakt"><span>Erstgespräch</span><b class="arrow arrow--sm" aria-hidden="true"></b></a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu>
      <span class="menu-button__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="menu-button__label" data-menu-label>Menü</span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu inert>
  <nav class="mobile-nav" aria-label="Hauptnavigation mobil">
    {siteConfig.nav.map((item, i) => (
      <a href={item.href}>
        <span class="mobile-nav__idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="mobile-nav__label">{item.label}</span>
        <b class="arrow arrow--sm" aria-hidden="true"></b>
      </a>
    ))}
  </nav>
  <div class="mobile-menu__foot">
    <a class="btn btn-orange mobile-menu__cta" href="#kontakt">
      Kostenloses Erstgespräch <span class="arrow arrow--sm" aria-hidden="true"></span>
    </a>
    <p>Websites, Apps und Software für kleine und mittelständische Unternehmen.</p>
  </div>
</div>
