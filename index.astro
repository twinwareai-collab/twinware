---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Sparten from "../components/Sparten.astro";
import Leistungen from "../components/Leistungen.astro";
import ResponsiveShowcase from "../components/ResponsiveShowcase.astro";
import Ablauf from "../components/Ablauf.astro";
import UeberUns from "../components/UeberUns.astro";
import Kontakt from "../components/Kontakt.astro";
import { site } from "../data/site";
---

<Base title={`${site.name} – ${site.tagline}`}>
  <Hero />
  <Sparten />
  <Leistungen />
  <ResponsiveShowcase />
  <Ablauf />
  <UeberUns />
  <Kontakt />
</Base>
