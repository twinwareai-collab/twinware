---
import { site } from "../data/site";
---

<section class="hero">
  <canvas class="hero__scene" aria-hidden="true"></canvas>

  <div class="hero__inner shell">
    <p class="hero__kicker">Softwarefirma mit Konzern-Erfahrung im Rücken</p>

    <h1 class="hero__title display" aria-label={site.name}>
      <span class="hero__scramble" aria-hidden="true">
        {
          [..."TWINWARE"].map((c, i, arr) => (
            <span class="ch" style={`--i:${i}`}>
              <span class="ch-spacer">{c}</span>
              <span class="ch-glyph" data-final={c}>{c}</span>
              {i === arr.length - 1 && <span class="hero__cursor" />}
            </span>
          ))
        }
      </span>
    </h1>

    <div class="hero__foot">
      <p class="hero__sub">
        Websites und Webapps aus {site.city}. Wir bauen die Dinge,
        die Ihr Betrieb jeden Tag benutzt – und danach lassen wir Sie damit nicht
        allein.
      </p>
      <a class="textlink hero__link" href="#leistungen">Was wir machen</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 85% at 88% 115%, rgba(255, 75, 46, 0.38), transparent 60%),
      radial-gradient(70% 55% at 8% -15%, rgba(255, 75, 46, 0.16), transparent 60%),
      var(--color-night);
    color: var(--color-paper);
    padding-top: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 1cm);
    min-height: calc(100svh - 1cm);
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    transition: opacity 1.8s ease;
    pointer-events: none;
  }

  .hero__scene.is-active {
    opacity: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .hero__kicker {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: -0.005em;
    color: #cfc9c2;
  }

  .hero__title {
    font-size: clamp(3.5rem, 15.2vw, 15rem);
    margin: 0;
  }

  .hero__scramble {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-variant-ligatures: none;
  }

  .ch {
    position: relative;
    display: inline-block;
  }

  .ch-spacer {
    visibility: hidden;
  }

  .ch-glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    text-shadow: none;
    transition:
      color 0.15s ease,
      text-shadow 0.15s ease;
  }

  .ch-glyph.is-locking {
    color: var(--color-accent);
    text-shadow: 0 0 0.5em rgba(255, 75, 46, 0.85);
  }

  .ch:nth-child(5) .ch-glyph {
    color: var(--color-accent);
  }

  .hero__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 0.09em;
    margin-left: 0.06em;
    background: var(--color-accent);
    opacity: 0;
  }

  .hero__cursor.is-blinking {
    animation: cursor-blink 0.85s step-end 5;
  }

  @keyframes cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-glyph {
      transition: none;
    }
    .hero__cursor {
      display: none;
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__sub {
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: #cfc9c2;
  }

  @media (min-width: 60rem) {
    .hero__foot {
      grid-template-columns: minmax(0, 38rem) auto;
      align-items: end;
      justify-content: space-between;
      gap: 3rem;
    }
    .hero__link {
      margin-bottom: 0.35rem;
    }
  }

</style>

<script>
  import * as THREE from "three";

  let activeScene: ReturnType<typeof initGridScene> | null = null;
  let activeObserver: IntersectionObserver | null = null;

  function initGridScene(
    hero: HTMLElement,
    canvas: HTMLCanvasElement,
    reduceMotion: boolean,
  ) {
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
    } catch {
      return null;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 40);
    const baseCamY = 1.5;
    const baseRotX = -0.18;
    camera.position.set(0, baseCamY, 5.5);
    camera.rotation.x = baseRotX;

    const ROWS = 52;
    const COLS = 34;
    const CELL = 0.62;
    const geometry = new THREE.PlaneGeometry(COLS * CELL, ROWS * CELL, COLS, ROWS);

    // Die Welle rechnet die GPU. Damit faellt pro Frame jede CPU-Arbeit und
    // jeder Buffer-Upload weg - und es ist Platz fuer mehrere Wellenlagen.
    const uniforms = {
      uTime: { value: 0 },
      uAmp: { value: 0.52 },
      uPush: { value: 0 },
      uColor: { value: new THREE.Color(0xff4b2e) },
      uHot: { value: new THREE.Color(0xffe0d2) },
      uNear: { value: 3.0 },
      uFar: { value: 19.0 },
    };

    const material = new THREE.ShaderMaterial({
      uniforms,
      transparent: true,
      depthWrite: false,
      wireframe: true,
      vertexShader: `
        uniform float uTime;
        uniform float uAmp;
        uniform float uPush;
        varying float vH;
        varying float vDepth;

        void main() {
          vec3 p = position;

          // zwei langsame Grundwellen ...
          float w1 = sin(p.x * 0.32 + uTime * 0.65);
          float w2 = sin(p.y * 0.24 - uTime * 0.48);
          float w3 = sin((p.x + p.y) * 0.16 + uTime * 0.33);

          // ... plus ein Ring, der nach aussen laeuft und dabei ausklingt.
          float r = length(p.xy);
          float ripple = sin(r * 0.55 - uTime * 1.7) * exp(-r * 0.055);

          float h = w1 * w2 * 0.6 + w3 * 0.35 + ripple * 1.1;
          p.z = h * uAmp * (1.0 + uPush);

          vH = h;
          vec4 mv = modelViewMatrix * vec4(p, 1.0);
          vDepth = -mv.z;
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        uniform vec3 uColor;
        uniform vec3 uHot;
        uniform float uNear;
        uniform float uFar;
        varying float vH;
        varying float vDepth;

        void main() {
          // Wellenberge gluehen, Taeler treten zurueck.
          float crest = smoothstep(-0.45, 1.15, vH);
          vec3 col = mix(uColor, uHot, crest);

          float fade = 1.0 - smoothstep(uNear, uFar, vDepth);
          float alpha = (0.26 + crest * 0.74) * fade;
          if (alpha < 0.012) discard;

          gl_FragColor = vec4(col, alpha);
        }
      `,
    });

    const grid = new THREE.Mesh(geometry, material);
    grid.rotation.x = -Math.PI / 2;
    grid.position.set(0, -1.1, -ROWS * CELL * 0.5 + 2);
    scene.add(grid);

    function resize() {
      const w = hero.clientWidth;
      const h = hero.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener("resize", resize);

    let pointerX = 0;
    let pointerY = 0;
    let targetPointerX = 0;
    let targetPointerY = 0;
    let onPointerMove: ((event: PointerEvent) => void) | null = null;

    if (!reduceMotion && window.matchMedia("(hover: hover)").matches) {
      onPointerMove = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect();
        targetPointerX = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        targetPointerY = ((event.clientY - rect.top) / rect.height) * 2 - 1;
      };
      hero.addEventListener("pointermove", onPointerMove);
    }

    function scrollProgress() {
      const rect = hero.getBoundingClientRect();
      const total = rect.height || 1;
      return Math.min(1, Math.max(0, -rect.top / total));
    }

    let raf = 0;
    let running = false;
    let elapsed = 0;
    let lastFrame = performance.now();

    function renderStatic() {
      resize();
      renderer.render(scene, camera);
    }

    // Selbstregelnde Qualitaet: bleibt die Bildrate laenger unter etwa 50 fps,
    // wird die Renderaufloesung eine Stufe zurueckgenommen. Das faengt schwache
    // oder gedrosselte GPUs ab, statt dauerhaft zu ruckeln.
    const RATIO_STEPS = [Math.min(window.devicePixelRatio || 1, 1.5), 1.15, 0.9, 0.7];
    let ratioStep = 0;
    let slowFrames = 0;
    let checked = 0;

    function watchPerformance(dt: number) {
      if (ratioStep >= RATIO_STEPS.length - 1) return;
      checked += 1;
      if (dt > 0.02) slowFrames += 1;

      if (checked < 90) return;
      if (slowFrames > 45) {
        ratioStep += 1;
        renderer.setPixelRatio(RATIO_STEPS[ratioStep]);
        resize();
      }
      checked = 0;
      slowFrames = 0;
    }

    function loop(now: number) {
      const dt = Math.min((now - lastFrame) / 1000, 0.05);
      lastFrame = now;
      elapsed += dt;
      watchPerformance(dt);

      const progress = scrollProgress();

      pointerX += (targetPointerX - pointerX) * 0.04;
      pointerY += (targetPointerY - pointerY) * 0.04;

      const speed = 1.4 + progress * 3.2;
      grid.position.z += dt * speed;
      if (grid.position.z > CELL) grid.position.z -= CELL;

      // Beim Scrollen baut sich die Welle auf.
      uniforms.uTime.value = elapsed;
      uniforms.uPush.value = progress * 0.9;

      camera.position.y = baseCamY - progress * 0.55;
      camera.rotation.x = baseRotX - progress * 0.16 + pointerY * -0.05;
      camera.rotation.y = pointerX * 0.08;

      renderer.render(scene, camera);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (reduceMotion) {
        renderStatic();
        return;
      }
      if (running) return;
      running = true;
      lastFrame = performance.now();
      raf = requestAnimationFrame(loop);
    }

    function pause() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      running = false;
    }

    function cleanup() {
      if (raf) cancelAnimationFrame(raf);
      window.removeEventListener("resize", resize);
      if (onPointerMove) hero.removeEventListener("pointermove", onPointerMove);
      geometry.dispose();
      material.dispose();
      // dispose() gibt den WebGL-Kontext NICHT frei - ohne das hier sammeln
      // sich die Kontexte, bis der Browser die aeltesten abschiesst.
      renderer.forceContextLoss();
      renderer.dispose();
    }

    return { start, pause, cleanup };
  }

  function initHeroFx() {
    const hero = document.querySelector<HTMLElement>(".hero");
    const canvas = hero?.querySelector<HTMLCanvasElement>(".hero__scene");
    const glyphs = hero?.querySelectorAll<HTMLElement>(".hero__title .ch-glyph");
    const cursor = hero?.querySelector<HTMLElement>(".hero__cursor");
    if (!hero || !canvas || !glyphs || !glyphs.length) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Diagnose: ?fx=none oder ?fx=mark laesst das Gitter weg.
    const fx = new URLSearchParams(location.search).get("fx");
    const gridOff = fx === "none" || fx === "mark";

    activeScene?.cleanup();
    activeScene = gridOff ? null : initGridScene(hero, canvas, reduceMotion);

    let revealed = false;

    activeObserver?.disconnect();
    activeObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (revealed) activeScene?.start();
          } else {
            activeScene?.pause();
          }
        }
      },
      { threshold: 0 },
    );
    activeObserver.observe(hero);

    function start() {
      canvas!.classList.add("is-active");
      revealed = true;
      activeScene?.start();
    }

    if (reduceMotion) {
      start();
      return;
    }

    const CHARSET = "01#%&+=/<>{}[]$*ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const TICK_MS = 45;
    const SCRAMBLE_MS = 480;
    const STAGGER_MS = 150;
    const START_DELAY_MS = 150;

    let maxFinish = 0;

    glyphs.forEach((glyph, i) => {
      const final = glyph.dataset.final ?? glyph.textContent ?? "";
      const delay = START_DELAY_MS + i * STAGGER_MS;
      const finish = delay + SCRAMBLE_MS;
      maxFinish = Math.max(maxFinish, finish);

      let elapsed = 0;
      const timer = window.setInterval(() => {
        elapsed += TICK_MS;
        if (elapsed < delay) return;
        if (elapsed >= finish) {
          glyph.textContent = final;
          glyph.classList.add("is-locking");
          window.setTimeout(() => glyph.classList.remove("is-locking"), 260);
          window.clearInterval(timer);
          return;
        }
        glyph.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
      }, TICK_MS);
    });

    window.setTimeout(() => {
      cursor?.classList.add("is-blinking");
      start();
    }, maxFinish + 250);
  }

  // astro:page-load feuert auch beim ERSTEN Laden - ein direkter Aufruf
  // zusaetzlich wuerde alles doppelt initialisieren.
  document.addEventListener("astro:page-load", initHeroFx);
  document.addEventListener("astro:before-swap", () => {
    activeObserver?.disconnect();
    activeObserver = null;
    activeScene?.cleanup();
    activeScene = null;
  });
</script>
