---
import { ablauf } from "../data/site";
---

<section class="section section--tight" id="ablauf">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div>
        <h2 class="headline">Vom ersten Anruf bis zum laufenden Betrieb.</h2>
      </div>
    </div>

    <ol class="steps">
      {
        ablauf.map((s, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="step__meta">{s.meta}</span>
            <h3 class="headline headline--sm step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-ink);
  }

  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 2rem 0 2.25rem;
    border-bottom: 1px solid var(--color-rule);
  }

  /* Markierung auf der Zeitachse statt Nummer im Kasten. */
  .step::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay);
  }

  .step.is-revealed::before {
    transform: scaleX(1);
  }

  @media (min-width: 56rem) {
    .step {
      padding-right: clamp(1.5rem, 3vw, 3rem);
      border-bottom: 0;
    }

    .step + .step {
      padding-left: clamp(1.5rem, 3vw, 3rem);
      border-left: 1px solid var(--color-rule);
    }
  }

  .step__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .step__title {
    margin-top: 0.15rem;
  }

  .step__text {
    color: var(--color-muted);
    font-size: 0.9375rem;
    max-width: 24rem;
  }
</style>
