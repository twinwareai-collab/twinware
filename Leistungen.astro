---
import { leistungen } from "../data/site";
---

<section class="section" id="leistungen">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div>
        <h2 class="headline">
          Sechs Sachen stehen<br class="br" /> zur Auswahl.
        </h2>
        <p class="lede prose-note grid-note">
          Nicht alles davon brauchen Sie. Wahrscheinlich zwei davon.
        </p>
      </div>
    </div>

    <div class="grid">
      {
        leistungen.map((l, i) => (
          <article
            class:list={["cell", `cell--${l.size}`]}
            data-reveal
            style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}
          >
            <div class="cell__head">
              <span class="cell__num">{String(i + 1).padStart(2, "0")}</span>
              <p class="cell__tag">{l.tag}</p>
            </div>
            <h3 class="headline headline--sm cell__title">{l.title}</h3>
            <p class="cell__text">{l.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .br {
    display: none;
  }

  @media (min-width: 40rem) {
    .br {
      display: inline;
    }
  }

  .grid-note {
    margin-top: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .cell {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    align-content: start;
    gap: 0.65rem;
    background: var(--color-panel);
    position: relative;
  }

  @media (min-width: 48rem) {
    .cell {
      grid-column: span 2;
    }

    .cell--wide {
      grid-column: span 4;
    }

    .cell--tall {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* Reihenfolge aus data/site.ts: breit | normal / hoch | normal | normal / [hoch] | breit */
  .cell:nth-child(1),
  .cell:nth-child(5) {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .cell:nth-child(3) {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .cell__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .cell__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--color-rule);
  }

  .cell:nth-child(1) .cell__num,
  .cell:nth-child(5) .cell__num {
    color: rgba(250, 249, 247, 0.3);
  }

  .cell:nth-child(3) .cell__num {
    color: rgba(17, 17, 17, 0.3);
  }

  .cell__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cell:nth-child(1) .cell__tag,
  .cell:nth-child(5) .cell__tag {
    color: rgba(250, 249, 247, 0.55);
  }

  .cell:nth-child(3) .cell__tag {
    color: rgba(17, 17, 17, 0.6);
  }

  .cell--wide .cell__title {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
  }

  .cell__text {
    color: var(--color-muted);
    max-width: 32rem;
    font-size: 0.9375rem;
  }

  .cell:nth-child(1) .cell__text,
  .cell:nth-child(5) .cell__text {
    color: #b8b2ab;
  }

  .cell:nth-child(3) .cell__text {
    color: rgba(17, 17, 17, 0.7);
  }

  .cell--wide .cell__text {
    font-size: 1.0625rem;
  }
</style>
